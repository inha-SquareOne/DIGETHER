# Unreal-generated directories (also covers nested projects and plugins)
Binaries/
Intermediate/
Saved/
DerivedDataCache/
# Packaging-generated open-order logs (rest of Build stays tracked)
/DIGETHER/Build/Windows/FileOpenOrder/CookerOpenOrder.log
/DIGETHER/Build/Windows/FileOpenOrder/EditorOpenOrder.log

# IDE caches and generated project files
.vs/
.idea/
*.sln
*.slnx
*.suo
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj/
*.xcworkspace/

# Local crash/debug output
*.pdb
*.dmp

# Local Python caches and personal BMAD overrides
# Local work notes and handover index
/.claude/docs/

**/__pycache__/
_bmad/config.user.toml
_bmad/custom/*.user.toml
_bmad/core/config.user.yaml
_bmad/gds/config.user.yaml
# BMAD 결과물은 로컬 전용이다(2026-11-04 결정).
/_bmad-output/

# Keep Config, Content, Source, Build, SourceArt and .vsconfig tracked.
# Required precompiled plugins need explicit Binaries exceptions when introduced.

# Content 분리(ADR-004): 로직 폴더만 Git, 나머지 Content와 SourceArt는 SVN.
# Git 폴더: Game/Blueprints, Game/UI, Game/Input, Data, Input, Editor, Frontend/UI, Frontend/Localization
/DIGETHER/Content/*
!/DIGETHER/Content/Data/
!/DIGETHER/Content/Input/
!/DIGETHER/Content/Editor/
!/DIGETHER/Content/Game/
/DIGETHER/Content/Game/*
!/DIGETHER/Content/Game/Blueprints/
!/DIGETHER/Content/Game/UI/
!/DIGETHER/Content/Game/Input/
!/DIGETHER/Content/Frontend/
/DIGETHER/Content/Frontend/*
!/DIGETHER/Content/Frontend/UI/
!/DIGETHER/Content/Frontend/Localization/
/DIGETHER/SourceArt/
.svn/
